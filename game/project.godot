config_version=5

[application]
config/name="Brass Tide — The Shatter Coast"
config/version="0.001"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
driver/threads/thread_model=2
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.045, 0.11, 0.15, 1)

[physics]
common/physics_ticks_per_second=60

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/inference_on_variant=0

