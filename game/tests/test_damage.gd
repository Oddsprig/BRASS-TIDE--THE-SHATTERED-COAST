extends SceneTree
const D=preload("res://scripts/damage.gd")
const SPEC={"id":"test","name":"Skiff","hp":140,"armor":0,"crewMin":2,"crewOptimal":5,"crewMax":7,"pumps":0}
func check(ok: bool,msg: String) -> void:
	if not ok:
		push_error(msg)
		quit(1)
	assert(ok,msg)
func advance(s: Dictionary,seconds: float) -> void:
	for i in range(int(seconds*10)):
		D.tick_ship(s,0.1)
func _initialize() -> void:
	var rng: RandomNumberGenerator=RandomNumberGenerator.new()
	rng.seed=25
	var s: Dictionary=D.create_ship(SPEC,{"crew":0})
	D.apply_hit(s,{"damage":25,"kind":"torpedo"},rng)
	check(is_equal_approx(s.hp,131.25),"Hull scale 0.35")
	check(is_equal_approx(D.sum_areas(s),125.0),"Unscaled breach")
	advance(s,120)
	check(s.sunk,"Unattended breach sinks")
	s=D.create_ship(SPEC,{"water":100.0,"breaches":[{"area":20.0,"section":"bow"}]})
	D.set_policy(s,"fight")
	var fight: Dictionary=D.get_status(s)
	D.set_policy(s,"bail")
	var bail: Dictionary=D.get_status(s)
	check(bail.crewBail>fight.crewBail and bail.crewGuns<fight.crewGuns,"Bail labor tradeoff")
	check(is_equal_approx(bail.crewGuns+bail.crewBail+bail.crewRepair,5.0),"Limited crew")
	check(bail.bailing>bail.inflow,"Light breach controllable")
	var before: Dictionary=s.duplicate(true)
	D.get_status(s)
	check(s==before,"Read-only status")
	s=D.create_ship(SPEC,{"policy":"repair","breaches":[{"area":100.0,"section":"bow"}]})
	advance(s,10)
	check(D.sum_areas(s)>30,"Patching takes tens of seconds")
	advance(s,15)
	check(is_zero_approx(D.sum_areas(s)),"Repair closes hole")
	s=D.create_ship(SPEC,{"supplies":0.1,"policy":"repair","breaches":[{"area":100.0,"section":"bow"}]})
	advance(s,15)
	check(s.supplies>=0 and D.sum_areas(s)>90,"Finite supplies")
	s=D.create_ship(SPEC,{"supplies":0.0,"policy":"bail","water":100.0})
	advance(s,5)
	check(s.water<100 and s.supplies==0,"Bail consumes no supplies")
	s=D.create_ship(SPEC,{"hp":70.0,"wounded":2.0,"supplies":0.0,"water":20.0,"breaches":[{"area":20.0,"section":"bow"}]})
	before=s.duplicate(true)
	check(D.repair_at_port(s,0).cost==0 and s==before,"Zero budget unchanged")
	var service: Dictionary=D.repair_at_port(s,37)
	check(service.cost>0 and service.cost<=37 and service.repaired,"Partial service")
	D.repair_at_port(s,10000)
	check(s.hp==s.maxHp and s.wounded==0 and s.supplies==20 and s.water==0,"Full service")
	check(D.repair_at_port(s,100).cost==0,"Healthy service free")
	s=D.create_ship(SPEC,{"cooldown":1.0,"hp":100.0})
	advance(s,2)
	check(s.cooldown==0 and s.hp==100,"Cooldown advances, HP persists")
	s=D.create_ship(SPEC,{"supplies":0.0,"policy":"bail","breaches":[{"area":200.0,"section":"bow"}]})
	advance(s,120)
	check(s.sunk,"Large torpedo hole overwhelms unpatched fully crewed skiff")
	s=D.create_ship(SPEC)
	D.apply_hit(s,{"damage":10,"kind":"bullet"},rng)
	check(s.crew>=4 and s.wounded<=1,"Ordinary bullet never annihilates crew")
	for i in range(30):
		D.apply_hit(s,{"damage":10,"kind":"bullet"},rng)
	advance(s,1000)
	for key in ["hp","crew","wounded","water","fire","engine","supplies","ammo","fuel"]:
		check(is_finite(float(s[key])) and s[key]>=0,"Finite nonnegative "+key)
	print("damage: all native tests passed")
	quit(0)
