extends SceneTree
const Money=preload("res://scripts/money.gd")
var checks: int=0
var failures: int=0
func check(ok: bool,text: String) -> void:
	checks+=1
	if not ok:failures+=1;print("FAIL boarding voyage: "+text)
func _initialize() -> void:
	var scene=load("res://main.tscn").instantiate();root.add_child(scene);await process_frame
	scene.save_directory=OS.get_user_data_dir().path_join("boarding-voyage-fixture");scene.new_game();scene.set_process(false);scene.set_physics_process(false)
	var c=scene.core
	Money.move(c.current_port(),"governmentPurse",c.state,"coins",150000,"Finite boarding fixture capital",c.state.moneyLog)
	var total: int=Money.total(c.state)
	var uid: String=str(c.state.fleet[0].uid)
	check(not c.BoardingOps.hire(c,uid,1).ok,"No free boarder qualifications are generated by migration or hiring")
	var r: Dictionary=c.TrainingOps.enroll(c,3,"boarder")
	check(r.ok,"Paid boarder course uses the actual academy: "+str(r.get("message","")))
	if not r.ok:scene.queue_free();await process_frame;quit(1);return
	for i in range(6):c.wait_day();scene.sync_economy()
	check(int(c.current_port().training.qualified.boarder)==3,"Six real paid academy days qualify the actual cohort")
	var workers: int=int(c.current_port().workforce);var crew: float=float(c.find_boat(uid).crew)
	r=c.BoardingOps.hire(c,uid,3)
	check(r.ok and float(c.find_boat(uid).crew)==crew+3 and int(c.current_port().workforce)==workers-3,"Hired trained boarders occupy the existing boat's real berths")
	check(int(c.find_boat(uid).boarders)==3 and Money.total(c.state)==total,"Boarders are a crew subset; advances move actual coins into their shared purse")
	var owner: Dictionary=c.fleet_owner("story-0")
	var target: Dictionary=owner.boats[0]
	# Inject a disabled surrender fixture into an ACTUAL existing enemy hull.
	# This verifies custody and integration, not a subjective capture success rate.
	target.hp=target.maxHp*0.3;target.engine=1.0;target.ammo=0;target.supplies=0;target.surrendering=true
	scene.begin_battle([target.spec],{"ownerId":owner.id,"kind":"patrol","id":owner.id,"name":"Boarding custody fixture"})
	var source: Dictionary=c.find_boat(uid)
	source.x=520;source.y=850;source.order="hold";source.orderTarget={"x":520.0,"y":850.0};source.ammo=0
	target.x=560;target.y=850;target.order="hold";target.orderTarget={"x":560.0,"y":850.0}
	var hp: float=float(target.hp);var fitted: String=JSON.stringify(target.loadout);var defenders: float=float(target.crew)
	r=c.BoardingOps.Combat.order(scene.battle,str(source.id),str(target.id),3)
	check(r.ok,"Actual tactical boarding order accepts a nearby surrendered damaged hull")
	for i in range(130):scene.Battle.update(scene.battle,1.0/30.0,{})
	check(target.get("captureSecured",false) and scene.battle.result=="won","Actual fixed-step battle resolves elapsed boarding and removes the secured prize from enemy combat")
	check(is_same(target,scene.battle.captured[0]) and float(target.hp)==hp and JSON.stringify(target.loadout)==fitted,"Capture preserves the exact hull, damage and fitted weapons")
	check(not scene.Battle.select_flagship(scene.battle,str(target.id)),"A secured damaged prize cannot bypass paid repair through manual flagship control")
	var loss_core=c.get_script().new(c.data.duplicate(true))
	var checkpoint: Dictionary=JSON.parse_string(JSON.stringify(c.state))
	var restored: Dictionary=loss_core.restore(checkpoint)
	check(restored.ok,"An actual capture-in-progress checkpoint can prepare an isolated loss branch")
	if restored.ok:
		var loss_target: Dictionary=loss_core.fleet_owner(str(owner.id)).boats[0]
		loss_target.sunk=true;loss_target.hp=0;loss_target.crew=0;loss_target.wounded=0;loss_target.boarders=0
		var loss_battle: Dictionary=scene.battle.duplicate(true)
		loss_battle.ships=loss_core.state.fleet+[loss_target];loss_battle.captured=[loss_target]
		var lost: Dictionary=loss_core.battle_settled("won",[loss_target.spec],scene.battle_context,loss_battle)
		check(lost.get("ok",true) and int(loss_core.state.captives)==0 and int(loss_core.state.boardingLostPeople)==int(defenders)+3,"A sunk secured prize records its actual party and defenders once instead of blocking settlement")
		check(loss_core.state.wrecks.any(func(w):return str(w.uid)==str(loss_target.uid)) and not loss_core.state.fleet.has(loss_target),"The same lost prize becomes a persistent physical wreck rather than a free living hull")
		check(Money.total(loss_core.state)==total and loss_core.restore(JSON.parse_string(JSON.stringify(loss_core.state))).ok,"Secured-prize loss preserves all coins and restores through the actual complete schema")
	var settled: Dictionary=c.battle_settled("won",[target.spec],scene.battle_context,scene.battle)
	check(settled.get("ok",true) and c.state.fleet.has(target) and not c.fleet_owner(str(owner.id)).boats.has(target),"Actual settlement transfers hull ownership once rather than cloning an enemy boat")
	check(int(c.state.captives)==int(defenders) and float(source.crew)+float(target.crew)==crew+3,"Prize crew and original defenders remain disjoint real people")
	check(c.Deployment.split(c.state.fleet).deployed.size()==1 and not c.FleetSupport.reserve(c,str(target.uid)).ok,"Damaged secured prizes add no battle deployment until paid harbor repair")
	check(c.restore(JSON.parse_string(JSON.stringify(c.state))).ok and Money.total(c.state)==total,"Captured fittings, crew, berths, purses and source ownership restore through full schema checks")
	target=c.find_boat(str(target.uid));c.state.position=c.port_position("brass_haven")
	check(not c.sell_boat(str(target.uid)).ok,"Captive carrier cannot be sold out from under its actual people")
	check(c.BoardingOps.release(c,int(c.state.captives)).ok and c.state.captives==0,"Safe harbor release returns existing captives to the workforce without reward coins")
	r=c.repair_boat(str(target.uid))
	check(r.ok and not target.supportOnly and not target.needsHarborRepair and target.hp==target.maxHp,"Paid actual harbor repair restores the same captured hull to combat: "+str(r.get("message","")))
	c.Factions.adjust(c.state,"compact",25,"Defense fixture earned standing","boarding-defense")
	var p: Dictionary=c.current_port()
	# Public procurement buys real local commercial inventory with treasury coins.
	for good in ["guns","ammo","timber","iron","supplies","food"]:
		var needed: float=maxf(0,float({"guns":1,"ammo":8,"timber":8,"iron":2,"supplies":6,"food":4}[good])-float(p.publicStores.get(good,0)))
		if needed<=0:continue
		var wallet: Dictionary={"coins":p.governmentPurse,"cargo":p.publicStores}
		var bought: Dictionary=c.Economy.transact(p,wallet,good,ceili(needed),"buy",100000)
		if bought.ok:p.governmentPurse=wallet.coins
	r=c.BoardingOps.build(c,"garrison",1)
	check(r.ok,"Actual paid coastal garrison commissions: "+str(r.get("message","")))
	if r.ok:
		var d: Dictionary=p.defenses
		check(not d.active,"A newly commissioned watch cannot fire before subsequent real payroll")
		c.wait_day();scene.sync_economy();p=c.current_port();d=p.defenses
		check(d.active and int(d.crew)==4,"The next actual economic day pays and provisions its separated defense crew")
		var combat: Dictionary=scene.Battle.create({"fleet":[c.find_boat(uid)],"enemySpecs":[c.hull("tin_skiff")],"seed":19})
		c.BoardingOps.coastal(c,combat)
		check(combat.get("coastalDefenses",[]).size()==1,"Only the nearby actual harbor supplies a physical defense position")
		combat.ships[1].x=320;combat.ships[1].y=850
		var ammo: int=int(d.ammo)
		scene.Battle.update(combat,1.0/30.0,{})
		check(int(d.ammo)==ammo-1 and combat.projectiles.any(func(shot):return str(shot.get("owner","")).begins_with("shore:")),"Visible native coastal projectile spends one actual held ammunition")
		var after: int=int(d.ammo);scene.Battle.update(combat,1.0/30.0,{})
		check(int(d.ammo)==after,"Actual cooldown prevents free per-frame defense shots")
	check(Money.total(c.state)==total and c.restore(JSON.parse_string(JSON.stringify(c.state))).ok,"Training, capture, repairs, public procurement and defense payroll preserve world coins and saved state")
	scene.mode="world";scene.ui.BoardingUI.open(scene.ui)
	check(scene.ui.modal_kind=="boarding","Actual hiring, prize, release, defense and academy controls render")
	scene.queue_free();await process_frame
	print("boarding voyage: %d checks, %d failures"%[checks,failures]);quit(0 if failures==0 else 1)
